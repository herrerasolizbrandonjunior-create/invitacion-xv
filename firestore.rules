// Pega esto en: Firebase > Firestore Database > Reglas > Publicar
// Cambia TU_CORREO@gmail.com por el correo del usuario creado en Authentication.
// Cualquier invitado puede CREAR datos válidos; solo tú (con login) puedes LEER, editar o borrar.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null && request.auth.token.email == 'zed.aviador@gmail.com';
    }

    match /confirmaciones/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nombre','asistira','personas','telefono','fecha'])
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 100
                    && request.resource.data.asistira in ['si', 'no']
                    && request.resource.data.personas is int
                    && request.resource.data.personas >= 0 && request.resource.data.personas <= 5
                    && request.resource.data.telefono is string && request.resource.data.telefono.size() <= 20
                    && request.resource.data.fecha == request.time;
      allow read, update, delete: if esAdmin();
    }

    match /firmas/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nombre','mensaje','fecha'])
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 100
                    && request.resource.data.mensaje is string
                    && request.resource.data.mensaje.size() > 0 && request.resource.data.mensaje.size() <= 500
                    && request.resource.data.fecha == request.time;
      allow read, update, delete: if esAdmin();
    }
  }
}
